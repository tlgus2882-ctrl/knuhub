# Copy to .env.local and fill in. .env.local is never committed.
# Values: Supabase dashboard → Project Settings → API Keys

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where signup confirmation links send people back to (no trailing slash).
# Local: http://localhost:3000  /  Vercel: https://<your-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret: bypasses RLS. Server-only admin tasks. Never paste it anywhere public.
SUPABASE_SECRET_KEY=sb_secret_...

# Secret: Claude API key for AI 검토 (Anthropic Console → API Keys). Without it the AI
# buttons say the feature is not set up. Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=sk-ant-...
# For now (development only): a free Google AI Studio key is used instead when set.
# The free tier lets Google use what we send, so switch to a paid key or ANTHROPIC_API_KEY
# before real 제출물 go through AI 검토, and remove this line.
GEMINI_API_KEY=
# Optional: the model for AI 검토 (default: gemini-3.5-flash-lite with GEMINI_API_KEY, else claude-haiku-5-5)
# AI_REVIEW_MODEL=claude-haiku-5-5

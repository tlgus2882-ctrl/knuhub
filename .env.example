# Copy to .env.local and fill in. .env.local is never committed.
# Values: Supabase dashboard → Project Settings → API Keys

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where signup confirmation links send people back to (no trailing slash).
# Local: http://localhost:3000  /  Vercel: https://<your-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret: bypasses RLS. Server-only admin tasks. Never paste it anywhere public.
SUPABASE_SECRET_KEY=sb_secret_...

# Secret: Claude API key for AI 검토 (Anthropic Console → API Keys). Without it the AI
# buttons say the feature is not set up. Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: the model for AI 검토 (default: claude-haiku-5-5)
# AI_REVIEW_MODEL=claude-haiku-5-5
